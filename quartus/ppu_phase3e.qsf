set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY ppu_background_core

set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/ppu/ppu_timing.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/ppu/ppu_scroll.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/ppu/ppu_registers.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/ppu/ppu_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/ppu/ppu_memory.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/ppu/ppu_background.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/ppu/ppu_background_core.sv
set_global_assignment -name SDC_FILE ../constraints/ppu_phase3e.sdc

set_global_assignment -name PROJECT_OUTPUT_DIRECTORY ../build/quartus_ppu_phase3e/output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name LAST_QUARTUS_VERSION "23.1std.1 Lite Edition"

# Standalone architecture proof: one real 50 MHz clock. All abstract CPU,
# cartridge, observation, and future-pixel-mixer ports are virtual.
set_location_assignment PIN_AF14 -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk
set_instance_assignment -name VIRTUAL_PIN ON -to reset
set_instance_assignment -name VIRTUAL_PIN ON -to ppu_enable
set_instance_assignment -name VIRTUAL_PIN ON -to cpu_enable
