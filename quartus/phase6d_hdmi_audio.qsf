set_global_assignment -name SDC_FILE ../constraints/phase6d_hdmi_audio.sdc
set_global_assignment -name VERILOG_MACRO "ALTERA_SYNTHESIS=1"

set_global_assignment -name PROJECT_OUTPUT_DIRECTORY ../build/quartus_phase6d_hdmi_audio/output_files
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
set_global_assignment -name OPTIMIZE_HOLD_TIMING "ALL PATHS"
set_global_assignment -name OPTIMIZE_MULTI_CORNER_TIMING ON
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4

set_location_assignment PIN_AF14 -to CLOCK_50
set_location_assignment PIN_AA14 -to RESET_N
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLOCK_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to RESET_N

# The DE1-SoC has no routed RGB888 HDMI transmitter.  Every Phase 6D
# boundary signal is intentionally virtual; a future qualified carrier must
# supply explicit electrical standards, voltage translation, and locations.
set_instance_assignment -name VIRTUAL_PIN ON -to DEVELOPER_LAYOUT
set_instance_assignment -name VIRTUAL_PIN ON -to TEST_PATTERN
set_instance_assignment -name VIRTUAL_PIN ON -to CAPTURE_FREEZE
set_instance_assignment -name VIRTUAL_PIN ON -to HDMI_HPD
set_instance_assignment -name VIRTUAL_PIN ON -to HDMI_I2C_SCL_IN
set_instance_assignment -name VIRTUAL_PIN ON -to HDMI_I2C_SDA_IN
set_instance_assignment -name VIRTUAL_PIN ON -to HDMI_I2C_SCL_DRIVE_LOW
set_instance_assignment -name VIRTUAL_PIN ON -to HDMI_I2C_SDA_DRIVE_LOW
set_instance_assignment -name VIRTUAL_PIN ON -to HDMI_PD
set_instance_assignment -name VIRTUAL_PIN ON -to HDMI_PCLK
set_instance_assignment -name VIRTUAL_PIN ON -to HDMI_RGB[*]
set_instance_assignment -name VIRTUAL_PIN ON -to HDMI_HSYNC
set_instance_assignment -name VIRTUAL_PIN ON -to HDMI_VSYNC
set_instance_assignment -name VIRTUAL_PIN ON -to HDMI_DE
set_instance_assignment -name VIRTUAL_PIN ON -to HDMI_FRAME_START
set_instance_assignment -name VIRTUAL_PIN ON -to HDMI_VIDEO_ENABLED
set_instance_assignment -name VIRTUAL_PIN ON -to HDMI_TX_PRESENT
set_instance_assignment -name VIRTUAL_PIN ON -to HDMI_TX_CONFIGURED
set_instance_assignment -name VIRTUAL_PIN ON -to HDMI_TX_FAULT
set_instance_assignment -name VIRTUAL_PIN ON -to HDMI_HPD_STATE[*]
set_instance_assignment -name VIRTUAL_PIN ON -to HDMI_EDID_VALID
set_instance_assignment -name VIRTUAL_PIN ON -to HDMI_MODE_SUPPORTED
set_instance_assignment -name VIRTUAL_PIN ON -to HDMI_STARTUP_STATE[*]
set_instance_assignment -name VIRTUAL_PIN ON -to HDMI_LAST_ERROR[*]
set_instance_assignment -name VIRTUAL_PIN ON -to HDMI_VIDEO_FRAMES[*]
set_instance_assignment -name VIRTUAL_PIN ON -to HDMI_I2C_NACKS[*]
set_instance_assignment -name VIRTUAL_PIN ON -to HDMI_I2C_TIMEOUTS[*]
set_instance_assignment -name VIRTUAL_PIN ON -to HDMI_RECOVERIES[*]
set_instance_assignment -name VIRTUAL_PIN ON -to VIDEO_LOCKED
set_instance_assignment -name VIRTUAL_PIN ON -to VIDEO_ERROR

set_global_assignment -name LAST_QUARTUS_VERSION "23.1std.1 Lite Edition"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"

# Logical qualification build only: all transmitter pins remain virtual.
set_parameter -name ALLOW_UNQUALIFIED_AUDIO 1
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/audio/audio_pll.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/audio/audio_async_fifo.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/audio/nes_audio_fir_coeff_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/audio/nes_audio_resampler.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/audio/nes_audio_conditioner.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/audio/wm8731_i2c_init.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/audio/wm8731_i2s_tx.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/audio/nes_audio_output.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/audio/hdmi_i2s_tx.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/audio/hdmi_audio_transport.sv
